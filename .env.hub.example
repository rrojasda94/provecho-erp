# Copiar a .env EN EL HUB de la sucursal (Raspberry Pi / mini-PC dedicado).
# Ver docker-compose.hub.yml y docs/architecture/adr/ADR-009-modo-offline-pdv.md.
#
# Todo lo que no aparece acá (JWT_SECRET, etc.) se completa igual que en
# .env.example — el hub corre la MISMA aplicación, no una versión reducida.

ENVIRONMENT=production
DEBUG=false

# Postgres LOCAL del hub (no el de la nube) — lo levanta este mismo compose.
DATABASE_URL=postgresql+psycopg://provecho:provecho@db:5432/provecho
POSTGRES_PASSWORD=provecho

# El mismo secreto que usa la nube: un login hecho en el hub durante un
# corte de internet sigue siendo válido si la sesión llega a tocar la nube
# más tarde, sin tener que reautenticar.
JWT_SECRET=

# Toda la LAN del local puede llamar al hub — no solo el frontend de dev.
CORS_ORIGINS=*
ALLOWED_HOSTS=*

DEPLOYMENT_MODE=hub
HUB_EMPRESA_ID=
HUB_SUCURSAL_ID=
# URL de la API en la nube contra la que este hub sincroniza.
CLOUD_SYNC_URL=https://erp.majambo.pe
# Cuenta de servicio (usuario.tipo=agente_ia) dedicada a este hub, con
# permisos mínimos (rol `hub_sucursal`: sync.leer + sync.empujar). Se crea
# una vez por sucursal, EN LA NUBE:
#   python -m src.seeders.hub --sucursal <HUB_SUCURSAL_ID> --username hub_<local>
CLOUD_SYNC_USERNAME=
CLOUD_SYNC_PIN=
SYNC_INTERVALO_SEGUNDOS=60
SYNC_FALLOS_PARA_OFFLINE=3
# Filas por página de sync (ambas direcciones).
SYNC_LOTE_MAXIMO=500

# Sin Factiliza en el hub: la emisión de comprobantes ocurre solo en la
# nube, después de sincronizar. No hace falta configurar estas variables acá.
FACTILIZA_TOKEN=
