# Copiar a .env EN EL DROPLET BI (ADR-081 Fase C) — un droplet aparte del de
# staging, chico (~$8/mes). Ver docker-compose.bi.yml y
# docs/engineering/bi-superset.md para el runbook completo.
#
# Este droplet no tiene Postgres propio ni Redis: Superset guarda su
# metadata en un esquema de la Postgres del droplet de staging
# (`scripts/superset_provision_db.sql`, corrido una vez a mano), a la que
# llega por la VPC privada de DigitalOcean — nunca por IP pública.

# Firma las sesiones de Superset. Generar uno propio, nunca reusar el
# JWT_SECRET de Provecho — son procesos y amenazas distintas.
#   python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=

# Rol `superset_meta` (creado por scripts/superset_provision_db.sql), IP
# PRIVADA del droplet de staging — nunca la pública.
SUPERSET_METADATA_DATABASE_URI=postgresql+psycopg2://superset_meta:<password>@<ip-privada-staging>:5432/provecho

# Admin de Superset. Uno solo, para el primer login y de ahí en más
# administrar desde la UI — el resto entra por SSO (ver OAUTH_BI_* abajo).
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@majambo.com.pe
SUPERSET_ADMIN_PASSWORD=

# SSO contra Provecho (ADR-081 Fase B) — mismos valores que
# OAUTH_BI_CLIENT_ID/SECRET en el `.env` del droplet de staging.
PROVECHO_API_URL=https://api-staging.majambo.com.pe
PROVECHO_WEB_URL=https://staging.majambo.com.pe
OAUTH_BI_CLIENT_ID=
OAUTH_BI_CLIENT_SECRET=
