{
    "extends": [
        "next/core-web-vitals",
        "next/typescript"
    ],
    "rules": {
        "@typescript-eslint/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "complexity": [
            "error",
            10
        ]
    },
    "overrides": [
        {
            "files": [
                "components/ui/**"
            ],
            "rules": {
                "complexity": "off"
            }
        }
    ]
}
