# Variables que lee el proceso de Next (`lib/mapas.ts`).
#
# **Solo hacen falta con `npm run dev` fuera de Docker.** En Docker las
# inyecta `docker-compose.yml` al servicio `web` desde el `.env` de la raíz,
# y este archivo no se usa. Copiar a `.env.local` para trabajar en local.
#
# NO son `NEXT_PUBLIC_*` a propósito: eso las hornearía en el build y la
# imagen quedaría atada a una clave.

# Clave de navegador de Google Maps (Maps JavaScript + Places (New) +
# Geocoding), restringida por dominio en la consola de Google. Vacía = los
# campos de dirección quedan como el cuadro de texto de siempre: sin
# buscador, sin mapa y sin punto que medir para cobrar el delivery.
GOOGLE_MAPS_BROWSER_KEY=

# Map ID de la consola (Maps > Gestión de mapas). Sin uno el pin no se
# dibuja; DEMO_MAP_ID es el que Google publica para desarrollo.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Sesga el autocompletado al país del negocio (ISO 3166-1 alfa-2).
GOOGLE_MAPS_PAIS=pe

# URL pública del BI (Superset, ADR-082). Vacía = el módulo BI muestra "no
# configurado" en vez de un enlace roto.
BI_URL=
