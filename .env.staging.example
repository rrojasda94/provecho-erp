# Plantilla para el `.env` de staging. Copiar en el servidor como `.env`,
# junto a docker-compose.staging.yml, y completar. Nunca commitear el
# resultado — ver docs/engineering/staging.md y devops.md#custodia-de-secretos.
#
#   cp .env.staging.example .env
#   chmod 600 .env
#
ENVIRONMENT=staging
DEBUG=false

# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Dominio real + hosts internos (sin ellos, TrustedHostMiddleware rechaza
# con 400 tanto el HEALTHCHECK del contenedor —Host: 127.0.0.1— como la
# llamada server-to-server del frontend a la API por la red de Docker
# —Host: api:8000—, sin pasar nunca por el proxy ni por el dominio público).
#
# `clientes.majambo.com.pe` (ADR-080) NO va en ninguna de las dos, aunque sea
# un dominio público más: el navegador nunca le habla a la API —la landing sale
# por Server Action contra `API_INTERNAL_URL`, y la CSP tiene
# `connect-src 'self'`—. Agregarlo sería ampliar la superficie de
# `TrustedHostMiddleware` sin que nadie la use.
ALLOWED_HOSTS=api-staging.majambo.com.pe,api,localhost,127.0.0.1
CORS_ORIGINS=https://staging.majambo.com.pe
RATE_LIMIT_LOGIN_INTENTOS=10
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=60

# Caddy reenvía a `api` por la red interna de Docker: el `X-Forwarded-For`
# que uvicorn ve viene de ahí, no de internet directamente. Confirmar la IP
# real del contenedor `caddy` en esa red con
# `docker network inspect provecho-erp_default` y pegarla acá — NUNCA "*".
# FORWARDED_ALLOW_IPS=

# Factiliza — token de QA (decidido 2026-08-23: activo en staging, los
# comprobantes emitidos NO son reales ante SUNAT).
FACTILIZA_BASE_URL=https://apife-qa.factiliza.com/api/v1
FACTILIZA_CONSULTA_BASE_URL=https://api.factiliza.com/v1
FACTILIZA_TOKEN=
FACTILIZA_TIMEOUT_SEGUNDOS=30
# La consulta la espera un cajero con el botón deshabilitado; la emisión
# corre en cola. Por eso el timeout va aparte y es corto.
FACTILIZA_CONSULTA_TIMEOUT_SEGUNDOS=8
IGV_PORCENTAJE=18

CELERY_BROKER_URL=

# WhatsApp — en espera (decisión 2026-08-23). Vacío = la encuesta funciona
# igual por enlace público, sin envío.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT_SEGUNDOS=15
WHATSAPP_PLANTILLA_ENCUESTA=encuesta_satisfaccion
WHATSAPP_PLANTILLA_IDIOMA=es

MARKETING_ENCUESTA_VIGENCIA_HORAS=72
MARKETING_URL_PUBLICA=

IZIPAY_API_KEY=
# `GOOGLE_API_KEY` **no la lee nadie**: quedó de una integración que nunca se
# escribió. Los nombres que el código busca son los `GOOGLE_MAPS_*` de abajo
# (`src/config/settings.py`, `frontend/lib/mapas.ts`). Una clave puesta acá
# con el nombre viejo no enciende nada, y no hay error que lo avise.
GOOGLE_API_KEY=
META_ACCESS_TOKEN=

# Google Maps — direcciones ancladas y delivery por distancia (ADR-053/054).
# Faltaban acá: sin ellas el droplet muestra el campo de dirección como un
# cuadro de texto y toda distancia sale estimada en línea recta, que es
# exactamente lo que parecía «la función no está construida».
# Paso a paso: docs/engineering/integraciones-google.md
#
# Del navegador: restringida por dominio, y son DOS —`staging.majambo.com.pe`
# y `clientes.majambo.com.pe`, el de la landing del QR (ADR-080)—. Con uno
# solo, el otro se comporta igual que si no hubiera clave.
GOOGLE_MAPS_BROWSER_KEY=
# El Map ID propio de la consola (Maps > Gestión de mapas, tipo JavaScript).
# `DEMO_MAP_ID` es el de desarrollo de Google: sirve para probar, pero no va en
# un dominio que ve un cliente. Sin Map ID válido el mapa se dibuja y el pin
# no, que es la falla que parece «anduvo».
GOOGLE_MAPS_MAP_ID=
# Del servidor: restringida por la IP del droplet. Nunca se pasa al `web`.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_PAIS=pe

# URL pública del BI, en su droplet aparte (ADR-083, ver
# docs/engineering/bi-superset.md). Vacía hasta que exista.
BI_URL=

# IP privada (VPC) del droplet de staging, para que Postgres publique 5432
# ahí y el droplet BI pueda leerlo sin exponerlo a internet. Vacía = `db`
# solo escucha en loopback (docker-compose.staging.yml). Ver
# docs/engineering/bi-superset.md — nunca la IP pública acá.
DB_VPC_BIND_IP=

# Semilla de la tarifa; la real la fija Gerencia en /gerencia/delivery
# (ADR-066) y vive en la base, no acá.
DELIVERY_TARIFA_BASE=0
DELIVERY_PRECIO_POR_KM=0
DELIVERY_DISTANCIA_MAXIMA_KM=0
DELIVERY_DISTRITOS_RESTRINGIDOS=

LOG_LEVEL=INFO
LOG_JSON=true
# Vacío por ahora — dar de alta cuando se levante el stack de observabilidad.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
HEALTH_COLA_MAXIMA=100
HEALTH_BACKUP_MAX_HORAS=26
HEALTH_LATIDO_WORKER_TTL=180

BACKUP_DIR=backups
BACKUP_RETENCION_DIAS=30
# BACKUP_VERIFY_DATABASE_URL=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

DEPLOYMENT_MODE=cloud

# Rol de Postgres de solo lectura para el BI (ADR-083 Fase A). Lo crea la
# propia migración (`alembic/versions/832ff01ed33f_...py`) al desplegar,
# pero SOLO si esta variable está puesta ANTES de correr `init` — sin ella,
# las vistas `vw_bi_*` se crean igual mas el rol `bi_lector` no, y el BI
# (Fase C) no tiene con qué conectarse. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BI_LECTOR_PASSWORD=

# OAuth2 del SSO del BI (ADR-083 Fase B) — mismos valores que en el `.env`
# del droplet BI (`.env.bi.example`). Vacíos = SSO apagado.
OAUTH_BI_CLIENT_ID=
OAUTH_BI_CLIENT_SECRET=
OAUTH_BI_REDIRECT_URI=

# Cuenta de servicio de Superset para embeber tableros en /dashboard
# (Fase D). Vacíos = sin embebido.
SUPERSET_INTERNAL_URL=
SUPERSET_SERVICE_USERNAME=
SUPERSET_SERVICE_PASSWORD=
BI_DASHBOARDS_EMBEBIBLES=
