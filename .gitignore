# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/.next/
# Override local para apuntar la API/worker al Postgres del compose en vez
# de la DATABASE_URL de .env (Supabase u otra remota) — solo conveniencia
# de dev, docker-compose lo carga automático si existe.
docker-compose.override.yml
frontend/out/

# Entorno
.env
.env.*
!.env.example
!.env.hub.example

# Paquetes de demo portable (`scripts/empaquetar_demo.py`): ~1 GB de imágenes
# de Docker por versión. Se reparten a mano, no se versionan.
ZIP_*/

# Backups de la base (nunca versionados: son datos reales del negocio).
# Anclado a la raíz: sin la barra inicial también tapaba `src/backups/`,
# que es el código del módulo y sí va al repositorio.
/backups/

# Guiones de capacitación (working files de producción de video, no versionados)
docs/capacitacion/*-guion-video.md
docs/capacitacion/*-ayudamemoria.md
docs/capacitacion/*-shotlist.html

# IDE / SO
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Temporales de Microsoft Word: `~$doc.docx` es el archivo de bloqueo que crea
# al abrir un .docx y `~WRLnnnn.tmp` el respaldo de autoguardado. Ambos son
# basura de sesión y no describen nada del proyecto.
~$*
~WRL*.tmp

# Tooling local de Claude Code (config y skills personales)
.claude/

# Base desechable y artefactos de las pruebas e2e.
e2e.db
# La crea el perfil `provecho-api-smoke` de `.claude/launch.json`.
pdv_smoke.db
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Scratch de TestSprite: credenciales del runner y salida de cada corrida.
testsprite_tests/tmp/
testsprite_tests/tmp/config.json
