<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Cobro" targetNamespace="http://www.bizagi.com/definitions/_cobro_provecho" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_COBRO" name="COBRO Y EMISION DE COMPROBANTE DE PAGO">
    <documentation>Alcance: detalle del paso "cobro" dentro de Venta (RN-COM-005, PROC-COM-001). Empieza en el cobro inmediato al confirmar el pedido (billetera digital, link de pago, transferencia, efectivo/POS en sucursal) o en el cobro post-entrega (billetera digital, transferencia, tarjeta o efectivo). Termina con la entrega del comprobante de pago al cliente. El cajero (Atencion al Cliente) es el responsable del proceso en todo momento, incluso cuando el cobro fisico lo ejecuta el repartidor.</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_Cliente" name="Cliente"><childLaneSet id="cls_Lane_Cliente" /></lane>
      <lane id="Lane_Repartidor" name="Repartidor / Deliverista"><childLaneSet id="cls_Lane_Repartidor" /></lane>
      <lane id="Lane_Cajero" name="Cajero (Atencion al Cliente)"><childLaneSet id="cls_Lane_Cajero" /></lane>
    </laneSet>

    <startEvent id="ca_start1" name="Pedido confirmado (cobro inmediato)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <outgoing>f1</outgoing>
    </startEvent>
    <startEvent id="re_start2" name="Producto entregado (cobro post-entrega)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <outgoing>f22</outgoing>
    </startEvent>
    <endEvent id="ca_end" name="Comprobante de pago entregado"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#FFD9D9" /><bizagi:BizagiProperty name="borderColor" value="#C0392B" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f72</incoming>
    </endEvent>

