<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_APERTURASUCURSAL" targetNamespace="http://www.bizagi.com/definitions/_aperturasucursal_provecho" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_APERTURASUCURSAL" name="APERTURA DE SUCURSAL">
    <documentation>Alcance: apertura de sucursal, desde que el encargado de tienda o supervisor llega al local (minimo 45 minutos antes de la hora de apertura al publico) hasta que la sucursal queda abierta al publico (cortinas levantadas, letrero "Abierto"). Incluye el checklist fisico de apertura (agua, banos, plagas, frios, gas - meta operativa de 5 minutos, no bloqueante), la recepcion del pedido de almacen central (detalle en PROC-INV-001), la limpieza diaria y programada de salon y cocina, y la apertura de caja (detalle en PROC-CTB-002). Reglas: RN-SUC-006 a RN-SUC-012, RN-PER-006. Las contingencias de personal faltante y de tardanza/falta del encargado o supervisor (RN-RRHH-010, RN-RRHH-011) ya tienen regla de negocio pero su diagrama BPMN se detalla en una sesion posterior.</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_Enc" name="Encargado de tienda / Supervisor"><childLaneSet id="cls_Lane_Enc" /></lane>
      <lane id="Lane_Ate" name="Personal de Atencion al Cliente"><childLaneSet id="cls_Lane_Ate" /></lane>
      <lane id="Lane_Coc" name="Personal de Cocina"><childLaneSet id="cls_Lane_Coc" /></lane>
    </laneSet>

    <startEvent id="e_start" name="Encargado o Supervisor llega a la sucursal (minimo 45 minutos antes de la hora de apertura al publico)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><outgoing>f1</outgoing></startEvent>
    <task id="e_puerta" name="Abre la puerta de la sucursal; la puerta de entrada permanece luego cerrada con llave"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f1</incoming><outgoing>f2</outgoing></task>
    <task id="e_alarma" name="Desactiva la alarma, si la hubiese"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f2</incoming><outgoing>f3</outgoing></task>
    <task id="e_marca" name="Marca su entrada en el ERP (enciende el terminal POS si esta apagado)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f3</incoming><outgoing>f4</outgoing></task>
    <task id="e_luces" name="Enciende las luces ambientales de salon y cocina (no las decorativas)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f4</incoming><outgoing>f5</outgoing></task>
