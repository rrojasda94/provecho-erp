    <sequenceFlow id="f1" sourceRef="ab_start" targetRef="ab_contar" />
    <sequenceFlow id="f2" sourceRef="ab_contar" targetRef="ab_gw_margen" />
    <sequenceFlow id="f3" name="Fuera de margen" sourceRef="ab_gw_margen" targetRef="ab_ajuste" />
    <sequenceFlow id="f4" sourceRef="ab_ajuste" targetRef="ab_sugerido" />
    <sequenceFlow id="f5" name="Dentro" sourceRef="ab_gw_margen" targetRef="ab_sugerido" />
    <sequenceFlow id="f6" sourceRef="ab_sugerido" targetRef="ab_solicitar" />
    <sequenceFlow id="f7" sourceRef="ab_solicitar" targetRef="ab_revisar" />
    <sequenceFlow id="f8" sourceRef="ab_revisar" targetRef="ab_gw_aprueba" />
    <sequenceFlow id="f9" name="No" sourceRef="ab_gw_aprueba" targetRef="ab_rechazar" />
    <sequenceFlow id="f10" sourceRef="ab_rechazar" targetRef="ab_end_rech" />
    <sequenceFlow id="f11" name="Si" sourceRef="ab_gw_aprueba" targetRef="ab_reservar" />
    <sequenceFlow id="f12" sourceRef="ab_reservar" targetRef="ab_picking" />
    <sequenceFlow id="f13" sourceRef="ab_picking" targetRef="ab_gw_completo" />
    <sequenceFlow id="f14" name="Parcial" sourceRef="ab_gw_completo" targetRef="ab_parcial" />
    <sequenceFlow id="f15" name="Completo" sourceRef="ab_gw_completo" targetRef="ab_despachar" />
    <sequenceFlow id="f16" sourceRef="ab_parcial" targetRef="ab_guia" />
    <sequenceFlow id="f17" sourceRef="ab_despachar" targetRef="ab_guia" />
    <sequenceFlow id="f18" sourceRef="ab_guia" targetRef="ab_trasladar" />
    <sequenceFlow id="f19" sourceRef="ab_trasladar" targetRef="ab_recibir" />
    <sequenceFlow id="f20" sourceRef="ab_recibir" targetRef="ab_gw_dif" />
    <sequenceFlow id="f21" name="No coincide" sourceRef="ab_gw_dif" targetRef="ab_registrar_dif" />
    <sequenceFlow id="f22" sourceRef="ab_registrar_dif" targetRef="ab_ingresar" />
    <sequenceFlow id="f23" name="Coincide" sourceRef="ab_gw_dif" targetRef="ab_ingresar" />
    <sequenceFlow id="f24" sourceRef="ab_ingresar" targetRef="ab_end" />
  </process>
  <collaboration id="Collab_1" name="ABASTECIMIENTO DE LOCALES - Provecho ERP">
    <participant id="Participant_INV001" name="ABASTECIMIENTO DE LOCALES" processRef="Process_INV001" />
  </collaboration>
