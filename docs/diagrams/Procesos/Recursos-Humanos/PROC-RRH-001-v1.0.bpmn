<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RRH001" targetNamespace="http://www.bizagi.com/definitions/_rrh001_provecho" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_RRH001" name="INCORPORACION DE PERSONAL">
    <documentation>Alcance: desde que un encargado detecta la necesidad de cubrir un puesto hasta que el trabajador supera (o no) el periodo de prueba. Cubre los 13 pasos de docs/rrhh/README.md: requisicion y perfil, publicacion, filtrado, entrevista, verificacion, oferta, eleccion de modalidad, firma y alta en T-Registro, file personal, induccion al grupo y al puesto, entrega de uniforme y evaluaciones de mes 1 y mes 2.5. Reglas: sin perfil no hay convocatoria (RN-RRHH-013); nadie inicia labores sin contrato firmado y alta en T-Registro (RN-RRHH-012); el candidato no entra a persona mientras es candidato (RN-GEN-007, ADR de contratacion); todo descarte lleva motivo, que es la defensa ante un reclamo por la Ley 26772.</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_Encargado" name="Encargado de tienda"><childLaneSet id="cls_Lane_Encargado" /></lane>
      <lane id="Lane_Admin" name="Administrador (ejecuta RRHH)"><childLaneSet id="cls_Lane_Admin" /></lane>
      <lane id="Lane_Candidato" name="Candidato / Postulante"><childLaneSet id="cls_Lane_Candidato" /></lane>
      <lane id="Lane_Contador" name="Contador externo"><childLaneSet id="cls_Lane_Contador" /></lane>
    </laneSet>

    <startEvent id="rr_start" name="Necesidad de cubrir un puesto"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="rr_requisicion" name="Comunicar requisicion: puesto, sucursal, motivo, fecha, turnos"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <task id="rr_valida" name="Validar el motivo contra venta, turnos y presupuesto de planilla"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
    </task>
    <exclusiveGateway id="rr_gw_perfil" name="Existe perfil del puesto?" gatewayDirection="Mixed"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#FFFFCC" /><bizagi:BizagiProperty name="borderColor" value="#A6A61D" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
      <outgoing>f5</outgoing>
    </exclusiveGateway>
    <task id="rr_redactar" name="Redactar el perfil con la plantilla del catalogo"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f4</incoming>
      <outgoing>f6</outgoing>
    </task>
    <task id="rr_publicar" name="Publicar convocatoria (sin perfil no se publica, RN-RRHH-013)"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements>
      <incoming>f5</incoming>
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
    </task>
