  </process>
  <collaboration id="Collab_1" name="INCORPORACION DE PERSONAL - Provecho ERP">
    <participant id="Participant_RRH001" name="INCORPORACION DE PERSONAL" processRef="Process_RRH001" />
  </collaboration>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="DE_Participant_RRH001" bpmnElement="Participant_RRH001" isHorizontal="true">
        <omgdc:Bounds x="20" y="20" width="3960" height="1010" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DE_Lane_Encargado" bpmnElement="Lane_Encargado" isHorizontal="true">
        <omgdc:Bounds x="50" y="90" width="3930" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DE_Lane_Admin" bpmnElement="Lane_Admin" isHorizontal="true">
        <omgdc:Bounds x="50" y="310" width="3930" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DE_Lane_Candidato" bpmnElement="Lane_Candidato" isHorizontal="true">
        <omgdc:Bounds x="50" y="530" width="3930" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DE_Lane_Contador" bpmnElement="Lane_Contador" isHorizontal="true">
