    <sequenceFlow id="f1" sourceRef="rr_start" targetRef="rr_requisicion" />
    <sequenceFlow id="f2" sourceRef="rr_requisicion" targetRef="rr_valida" />
    <sequenceFlow id="f3" sourceRef="rr_valida" targetRef="rr_gw_perfil" />
