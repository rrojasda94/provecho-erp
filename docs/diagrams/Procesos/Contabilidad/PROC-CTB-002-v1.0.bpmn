<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_APERTURACAJA" targetNamespace="http://www.bizagi.com/definitions/_aperturacaja_provecho" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_APERTURACAJA" name="APERTURA DE CAJA (POS)">
    <documentation>Alcance: apertura de caja, desde que el cajero asignado solicita al encargado de tienda/supervisor el efectivo (fondo/caja chica), los POS de pago con tarjeta y las llaves de la gaveta, hasta que la caja queda aperturada en el ERP y el efectivo asegurado en la gaveta, lista para pedidos y cobros. Sigue la cadena de custodia obligatoria del efectivo (RN-MDP-002) en sentido inverso al cierre: area contable/encargado de tienda/supervisor -&gt; cajero, con autenticacion (usuario + PIN) y confirmacion de valores en el relevo. Durante el conteo y la apertura, el encargado de tienda/supervisor no atiende otro proceso (RN-POS-013). Ni el faltante de efectivo, la escasez de sencillo, ni un POS averiado bloquean la apertura: se abre en el horario normal dejando constancia del problema (RN-POS-011), resuelto en paralelo con cambio de otra sucursal, recojo en oficinas de contabilidad, o el POS de emergencia del grupo de sucursales cercanas (RN-POS-009).</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_Cajero" name="Cajero (Atencion al Cliente)"><childLaneSet id="cls_Lane_Cajero" /></lane>
      <lane id="Lane_Encargado" name="Encargado de tienda / Supervisor"><childLaneSet id="cls_Lane_Encargado" /></lane>
    </laneSet>

    <startEvent id="ca_start1" name="Cajero asignado listo para aperturar caja"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><outgoing>f1</outgoing></startEvent>
    <task id="ca_solicitar1" name="Solicitar al encargado de tienda/supervisor: efectivo, POS de pago con tarjeta y llaves de la gaveta"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f1</incoming><outgoing>f2</outgoing></task>
    <task id="en_recibir1" name="Recibir la solicitud y autenticarse: usuario + PIN"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f2</incoming><outgoing>f3</outgoing></task>
    <task id="en_contar1" name="Contar junto al cajero el efectivo del fondo/caja chica, por denominacion"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f3</incoming><outgoing>f4</outgoing></task>
    <exclusiveGateway id="en_gw_coincide1" name="Coincide con el monto y denominacion del cierre anterior?" gatewayDirection="Diverging"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#FFFFCC" /><bizagi:BizagiProperty name="borderColor" value="#A6A61D" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f4</incoming><outgoing>f5</outgoing><outgoing>f6</outgoing></exclusiveGateway>
    <task id="en_reportarfaltante1" name="Reportar a contabilidad y gerencia via ERP: faltante de efectivo o escasez de sencillo"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f5</incoming><outgoing>f7</outgoing></task>
