<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CierreCaja" targetNamespace="http://www.bizagi.com/definitions/_cierre_caja_provecho" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_CIERRECAJA" name="CIERRE DE CAJA (POS)">
    <documentation>Alcance: cierre de caja al llegar la hora de cierre del establecimiento, dentro del horario de la jornada (RN-POS-004). Empieza al cerrar todas las mesas/cuentas abiertas y termina con el dinero a disposicion de la empresa. Sigue la cadena de custodia obligatoria del efectivo (RN-MDP-002): cajero -&gt; encargado de tienda/supervisor -&gt; area contable, con autenticacion (usuario + PIN) y confirmacion de valores en cada relevo. La atribucion del faltante depende de en que etapa se detecta y documenta (cierre/validacion vs. recien en contabilidad), y de si el cajero ya habia reportado un cobro mal hecho por un tercero segun PROC-COM-002.</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_Cajero" name="Cajero (Atencion al Cliente)"><childLaneSet id="cls_Lane_Cajero" /></lane>
      <lane id="Lane_Encargado" name="Encargado de tienda / Supervisor"><childLaneSet id="cls_Lane_Encargado" /></lane>
      <lane id="Lane_Contable" name="Area Contable"><childLaneSet id="cls_Lane_Contable" /></lane>
    </laneSet>

    <startEvent id="ca_start1" name="Hora de cierre segun el horario de la jornada"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#E6FF97" /><bizagi:BizagiProperty name="borderColor" value="#62A716" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><outgoing>f1</outgoing></startEvent>
    <task id="ca_verifmesas1" name="Verificar que no queden mesas o cuentas abiertas"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#ECEFFF" /><bizagi:BizagiProperty name="borderColor" value="#03689A" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f1</incoming><outgoing>f2</outgoing></task>
    <exclusiveGateway id="ca_gw_abiertas1" name="¿Hay mesas o cuentas abiertas?" gatewayDirection="Mixed"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#FFFFCC" /><bizagi:BizagiProperty name="borderColor" value="#A6A61D" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f2</incoming><incoming>f8</incoming><outgoing>f3</outgoing><outgoing>f4</outgoing></exclusiveGateway>
    <exclusiveGateway id="ca_gw_pagado1" name="¿El cliente ya pago la cuenta?" gatewayDirection="Diverging"><extensionElements><bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20"><bizagi:BizagiProperties><bizagi:BizagiProperty name="bgColor" value="#FFFFCC" /><bizagi:BizagiProperty name="borderColor" value="#A6A61D" /><bizagi:BizagiProperty name="textColor" value="#000000" /><bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" /><bizagi:BizagiProperty name="textDirection" value="" /></bizagi:BizagiProperties></bizagi:BizagiExtensions></extensionElements><incoming>f3</incoming><outgoing>f5</outgoing><outgoing>f6</outgoing></exclusiveGateway>
