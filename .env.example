# Copiar a .env y ajustar por entorno (local|development|testing|staging|production)
ENVIRONMENT=local
DEBUG=true

# Postgres del docker-compose visto DESDE EL HOST (alembic, pytest, uvicorn
# suelto): puerto 5433, porque el 5432 local lo ocupa Charlie's. Los
# contenedores no leen estas dos líneas — docker-compose.yml les inyecta
# `db:5432` y `redis:6379`, que son los nombres válidos dentro de su red.
DATABASE_URL=postgresql+psycopg://provecho:provecho@localhost:5433/provecho
REDIS_URL=redis://localhost:6379/0
# Segundos que Postgres deja correr una consulta antes de cancelarla. Son dos
# porque el ERP abre dos engines: el de operación (todo) y el de reportes
# (`/reportes`, `/tableros`, `/reports`), que legítimamente tarda más. Con un
# solo número habría que elegir entre matar reportes buenos o dejar la caja
# colgada. 0 = sin límite. Solo aplica a Postgres — SQLite no sabe cancelar
# una consulta por tiempo.
DB_STATEMENT_TIMEOUT_SEGUNDOS=15
DB_STATEMENT_TIMEOUT_REPORTES_SEGUNDOS=120
# Supabase (Postgres gestionado — visualización + disponible en línea, ver
# docs/engineering/devops.md): copiar el connection string del proyecto
# desde Settings > Database, anteponer "+psycopg" al esquema, NUNCA
# commitear la contraseña real (solo vive en .env, gitignorado). Para que los
# contenedores también apunten ahí hay que comentar el bloque
# `x-conexiones-internas` de docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Generar secreto real: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Endurecimiento HTTP (listas separadas por coma).
# Con ENVIRONMENT=production la app NO arranca si quedan en "*", si JWT_SECRET
# es el placeholder o mide menos de 32 caracteres, si DEBUG=true, o si
# DATABASE_URL conserva la contraseña por defecto.
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_LOGIN_INTENTOS=10
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=60

# Contraseña de Postgres en docker-compose (solo desarrollo local).
POSTGRES_PASSWORD=provecho

# Detrás de nginx/Caddy: IP del proxy, para que uvicorn confíe en
# X-Forwarded-For. NUNCA "*" (permitiría falsificar la IP del cliente).
# FORWARDED_ALLOW_IPS=172.18.0.1

# Facturación electrónica — Factiliza (proveedor elegido 2026-07-26,
# reemplaza a Nubefact). Sin FACTILIZA_TOKEN la emisión queda desactivada:
# el ERP vende y cobra igual, y los comprobantes se acumulan `pendiente`.
# QA:         https://apife-qa.factiliza.com/api/v1
# Producción: cambiar a conciencia — emite documentos reales ante SUNAT.
FACTILIZA_BASE_URL=https://apife-qa.factiliza.com/api/v1
# Consulta RUC/DNI (RENIEC/SUNAT) — mismo token, host propio sin sandbox QA.
FACTILIZA_CONSULTA_BASE_URL=https://api.factiliza.com/v1
FACTILIZA_TOKEN=
FACTILIZA_TIMEOUT_SEGUNDOS=30
IGV_PORCENTAJE=18

# Cola de tareas (Celery). Vacío = usa REDIS_URL.
CELERY_BROKER_URL=

# WhatsApp Cloud API (Meta) — encuesta de satisfacción (ADR-029).
# Sin WHATSAPP_TOKEN el módulo funciona igual: la encuesta se crea y se
# contesta por el enlace público o la tablet del local, y no se encola
# ningún envío.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Token que se acuerda con Meta para el handshake GET del webhook.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app: firma HMAC de cada webhook entrante. Sin él el webhook
# RECHAZA TODO (falla cerrado) — es la única prueba de que el mensaje viene
# de Meta y no de alguien que descubrió la URL. En producción, tener
# WHATSAPP_TOKEN sin este secreto impide arrancar.
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT_SEGUNDOS=15
# Plantilla aprobada con la que se abre la conversación: fuera de la ventana
# de 24 h de Meta no se puede mandar otra cosa.
WHATSAPP_PLANTILLA_ENCUESTA=encuesta_satisfaccion
WHATSAPP_PLANTILLA_IDIOMA=es

# Encuesta de satisfacción (marketing). Pasado el plazo, el barrido horario
# la expira: una respuesta de dos semanas después no mide ese pedido.
MARKETING_ENCUESTA_VIGENCIA_HORAS=72
# Base pública del formulario de encuesta (canal `link` y el enlace que
# viaja en el WhatsApp). Vacío = se envía solo el texto, sin enlace.
MARKETING_URL_PUBLICA=

# Google Maps — direcciones ancladas y cobro del delivery por distancia
# (ADR-053 y ADR-054). Son DOS claves porque Google no deja restringir la
# misma por referente HTTP y por IP a la vez, y son dos riesgos distintos.
# Paso a paso para obtenerlas: docs/engineering/integraciones-google.md
#
# La del navegador (Maps JavaScript + Places (New) + Geocoding) viaja al
# cliente a propósito: dibuja el mapa. Restringirla por dominio y ponerle
# cuota diaria en la consola de Google. Vacía = el campo de dirección queda
# como el cuadro de texto de siempre y el ERP funciona igual.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID de la consola (Maps > Gestión de mapas). Sin uno el pin no se
# dibuja; DEMO_MAP_ID es el que Google publica para desarrollo.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# La del servidor (Routes API) calcula la distancia con la que se cobra el
# delivery. Restringida por IP del servidor, NUNCA se pasa al contenedor
# `web`. Vacía = la distancia se estima en línea recta y se marca aproximada.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_TIMEOUT_SEGUNDOS=10
# Sesga el autocompletado al país del negocio (ISO 3166-1 alfa-2).
GOOGLE_MAPS_PAIS=pe

# Tarifa del delivery propio. Todo en 0 = función apagada: el delivery se
# sigue cobrando como hasta ahora. Nada se enciende solo.
DELIVERY_TARIFA_BASE=0
DELIVERY_PRECIO_POR_KM=0
# Pasado este radio se sugiere derivar a una plataforma externa (DAZ DAZ) en
# vez de mandar al repartidor propio. 0 = sin radio máximo.
DELIVERY_DISTANCIA_MAXIMA_KM=0
# Distritos donde no reparte el repartidor propio, separados por coma.
DELIVERY_DISTRITOS_RESTRINGIDOS=

# Integraciones (rellenar cuando se implementen los adaptadores)
IZIPAY_API_KEY=
META_ACCESS_TOKEN=

# Observabilidad (ver docs/engineering/devops.md#monitoreo-y-observabilidad)
LOG_LEVEL=INFO
# JSON siempre en producción; acá se fuerza también fuera de ella.
LOG_JSON=false
# Vacío = sin reporte de errores (local y tests no envían nada a terceros).
# **Decidido 2026-08-04: GlitchTip autoalojado** en el mismo VPS
# (docker-compose.observabilidad.yml). Habla el protocolo de Sentry, así que
# el código no cambia. El DSN se genera al crear el proyecto en GlitchTip —
# ver docs/engineering/observabilidad.md.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Chequeos de salud (/health/ready, /health/backups). 26 h y no 24 deja
# margen para que el cron diario corra sin disparar falsa alarma.
HEALTH_COLA_MAXIMA=100
HEALTH_BACKUP_MAX_HORAS=26
# TTL del latido del worker. 3× el intervalo del beat (1 min): tolera un
# ciclo perdido sin declararlo muerto.
HEALTH_LATIDO_WORKER_TTL=180

# --- Stack de observabilidad (docker-compose.observabilidad.yml) -----------
# Solo lo necesita el host que levanta ese stack, NO la API ni el worker.
GLITCHTIP_DB_PASSWORD=
# openssl rand -hex 32
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8088
# Puertos publicados (solo en 127.0.0.1). No son los obvios porque chocan:
# el 8080 suele estar tomado y el 3001 lo ocupa com.docker.backend con
# Docker Desktop.
GLITCHTIP_PORT=8088
GRAFANA_PORT=3002
LOKI_PORT=3100
# Qué proyectos de compose vigila Alloy. Alloy ve TODO el host: sin esto,
# los logs de otros proyectos del VPS terminan en este Loki.
ALLOY_PROYECTOS=provecho-erp
GLITCHTIP_FROM_EMAIL=errores@majambo.pe
# consolemail:// escribe el correo al log en vez de enviarlo — sirve para
# arrancar sin SMTP. Con SMTP real: smtp://usuario:clave@host:587
GLITCHTIP_EMAIL_URL=consolemail://
GRAFANA_ADMIN_PASSWORD=

# Backups (ver docs/engineering/devops.md)
BACKUP_DIR=backups
BACKUP_RETENCION_DIAS=30
# Base DESECHABLE donde se prueba la restauración de cada backup. Sin esto
# solo se valida el archivo, no que restaure de verdad. NUNCA apuntar a la
# base real: la restauración de prueba borra el esquema destino.
# BACKUP_VERIFY_DATABASE_URL=postgresql+psycopg://provecho:provecho@localhost:5433/provecho_verify

# S3 (storage + copia externa de backups). Sin credenciales, el backup
# queda solo en el servidor. Requiere: pip install -e ".[backups]"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Modo offline del PDV — hub local de sucursal (ADR-009). Dejar en "cloud"
# en la nube; en el hub de cada sucursal, ver .env.hub.example.
DEPLOYMENT_MODE=cloud
