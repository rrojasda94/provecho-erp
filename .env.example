# Copiar a .env y ajustar por entorno (local|development|testing|staging|production)
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://provecho:provecho@db:5432/provecho
REDIS_URL=redis://redis:6379/0

# Generar secreto real: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Integraciones (rellenar cuando se implementen los adaptadores)
NUBEFACT_URL=
NUBEFACT_TOKEN=
IZIPAY_API_KEY=
GOOGLE_API_KEY=
META_ACCESS_TOKEN=

# S3 (storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
